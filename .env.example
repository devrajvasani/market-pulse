# Template of every config key MarketPulse reads. Copy to `.env` for local
# overrides. `.env` is gitignored — NEVER commit real secret values (Section O.5).
# Day-to-day local config lives in config/environments/local.env; this file
# documents the full surface, including secrets set out-of-band.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=            # "aws" or "local" (default: local)
ENVIRONMENT=        # dev / staging / prod (used in resource names + tags; default: dev)
LOG_LEVEL=          # INFO / WARNING / ERROR (default: INFO)

# ── AWS ───────────────────────────────────────────────────────────────────────
# Local mode uses dummy creds (test/test) + the LocalStack endpoint.
# Real AWS creds live in ~/.aws — do NOT put them here.
AWS_ENDPOINT_URL=   # http://localhost:4566 locally; unset on real AWS
AWS_ACCESS_KEY_ID=  # "test" locally only
AWS_SECRET_ACCESS_KEY=  # "test" locally only
AWS_DEFAULT_REGION= # us-east-1

# ── LocalStack (local emulator) ───────────────────────────────────────────────
# OPTIONAL: the pinned localstack/localstack:3 image runs token-free. Only newer 4.x/2026.x
# images need a free token. It's a secret — put the real value in
# infrastructure/localstack/.env (gitignored), not here. Free account: https://app.localstack.cloud.
LOCALSTACK_AUTH_TOKEN=

# ── Application secrets (used from Stage 1+; never committed) ──────────────────
# On AWS these are read at runtime from Secrets Manager / SSM, not from env.
MARKETDATA_API_KEY=
NEWS_API_KEY=
