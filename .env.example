# Template for the root `.env` (GITIGNORED local secrets + overrides), auto-loaded by
# config/settings.py. Copy to `.env` and fill in.
#
# Non-secret local config (LocalStack endpoint, dummy test/test creds, region) lives in
# config/environments/local.env — don't duplicate it here.
# Real AWS account credentials live in ~/.aws/credentials (aws configure), NEVER here.

# ── Local app secrets (fill in) ───────────────────────────────────────────────
# CoinGecko free Demo key — https://www.coingecko.com/en/api  (Stage 1 ingestion)
MARKETDATA_API_KEY=
# News API key (Stage 5) (CryptoPanic, NewsAPI, etc.) — https://newsapi.org/ or https://cryptopanic.com/api/
NEWS_API_KEY=

# -- RAG LLM provider API keys (Stage 5) ---------------------------------------
# Provider selection lives in rag/config/llm.yaml (NO secrets there). Put only the key
# VALUES below; leave a provider blank if you don't use it. Keep comments on their OWN
# lines (never inline after KEY=) so a blank key stays truly empty.
# Embedding-capable: gemini, openai, bedrock, and a LOCAL Ollama server.
# NOTE: Ollama CLOUD has NO embeddings API -- use gemini/openai/bedrock for embeddings.

# Ollama Cloud (Turbo): https://ollama.com  (or set OLLAMA_HOST=http://localhost:11434 for local, no key)
OLLAMA_API_KEY=
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic (generation only): https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Groq (generation only, very fast): https://console.groq.com/keys
GROQ_API_KEY=
# Bedrock API key / bearer token (boto3 reads this env automatically)
AWS_BEARER_TOKEN_BEDROCK=

# ── Optional local overrides (uncomment to use; defaults apply otherwise) ──────
# APP_ENV=local
# LOG_LEVEL=DEBUG
# Switch the active LLM provider WITHOUT editing llm.yaml (handy for a quick speed test):
# RAG_GEN_PROVIDER=gemini
# RAG_EMBED_PROVIDER=gemini   # remember to rebuild the index after changing the embed provider
# RAG_GEN_FALLBACK=ollama
