# Local development — everything points at LocalStack with DUMMY credentials.
# Never put real AWS keys here (file 04 section 4.2 / plan Section O). Source it with:
#   set -a && . config/environments/local.env && set +a
APP_ENV=local
ENVIRONMENT=dev
LOG_LEVEL=INFO

# LocalStack endpoint + dummy creds — boto3 (Group A services) auto-respects these.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
